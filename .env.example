# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@localhost:5432/email_discord_bot"

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Scopes required: gmail.readonly, gmail.send
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_REDIRECT_URI="http://localhost:3000/oauth/callback"

# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
# Required intents: Guilds, GuildMessages, MessageContent (privileged)
# Required permissions: Send Messages, Read Message History, Embed Links
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""        # Channel ID to post email notifications
DISCORD_OPERATOR_USER_ID=""  # User ID to mention for notifications/approvals
DISCORD_GUILD_ID=""          # Optional: for guild-scoped slash command deployment

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER="openai"        # Supported: openai (default)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"        # Model to use for email draft generation

# ── Server ────────────────────────────────────────────────────────────────────
PORT="3000"
POLL_INTERVAL_MS="1800000"   # 30 minutes in milliseconds
